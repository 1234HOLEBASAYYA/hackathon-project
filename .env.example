# ==============================================================================
# MEDVISION-AI Unified Platform Configuration Template
# ==============================================================================

# Central Node.js & Express Gateway Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Shared MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/medvision_ai
MONGODB_DATABASE=medvision_ai

# Downstream AI Microservices Ports & URLs
PRESCRIPTION_SERVICE_URL=http://127.0.0.1:8001
XRAY_SERVICE_URL=http://127.0.0.1:8002
CT_SERVICE_URL=http://127.0.0.1:8003

# Gemini Multimodal Clinical Vision Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash

# Storage & Upload Limits
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=30

